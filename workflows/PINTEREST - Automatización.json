      "parameters": {
        "jsCode": "const items = $input.all();\n\nif (!items.length) {\n  throw new Error('No se han recibido recursos desde sheet3');\n}\n\n// Elegir 1 recurso al azar\nconst randomIndex = Math.floor(Math.random() * items.length);\nconst selected = items[randomIndex];\n\n// Obtener el campo donde está el enlace\nconst fileUrl = selected.json['FILE URL'] || selected.json['FILE ID'] || '';\n\n// Extraer el file_id desde una URL de Google Drive\nfunction extractFileId(url) {\n  if (!url) return '';\n  \n  const match1 = url.match(/\\/file\\/d\\/([^/]+)/);\n  if (match1) return match1[1];\n\n  const match2 = url.match(/[?&]id=([^&]+)/);\n  if (match2) return match2[1];\n\n  return '';\n}\n\nconst fileId = extractFileId(fileUrl);\n\nreturn [\n  {\n    json: {\n      ...selected.json,\n      recurso_seleccionado: selected.json.RECURSO,\n      file_url: fileUrl,\n      file_id: fileId,\n      total_opciones: items.length,\n      indice_seleccionado: randomIndex + 1\n    }\n  }\n];"
      },
